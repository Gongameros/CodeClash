@page "/courses/new"
@attribute [Authorize]

@inject ICoursesApiClient CoursesApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Create Course – CodeClash</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="mb-4 px-0" />
<MudText Typo="Typo.h4" Style="font-weight: 700;" Class="mb-6">Create New Course</MudText>

<MudGrid>
    <MudItem xs="12" md="8">
        <!-- Step indicator -->
        <MudPaper Class="pa-4 mb-4" Elevation="2" Style="border-radius: 12px;">
            <div class="d-flex align-center gap-2">
                @for (var i = 0; i < _steps.Length; i++)
                {
                    var stepIndex = i;
                    var isActive = stepIndex == _step;
                    var isDone = stepIndex < _step;
                    <div class="d-flex align-center gap-2 flex-grow-1">
                        <MudAvatar Size="Size.Small"
                                   Color="@(isDone ? Color.Success : isActive ? Color.Primary : Color.Default)"
                                   Variant="@(isActive || isDone ? Variant.Filled : Variant.Outlined)">
                            @if (isDone)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                            }
                            else
                            {
                                @(stepIndex + 1)
                            }
                        </MudAvatar>
                        <MudText Typo="Typo.body2"
                                 Style="@(isActive ? "font-weight:600;" : "opacity:0.6;")">
                            @_steps[stepIndex]
                        </MudText>
                        @if (stepIndex < _steps.Length - 1)
                        {
                            <MudDivider Class="flex-grow-1" />
                        }
                    </div>
                }
            </div>
        </MudPaper>

        <!-- Step content -->
        <MudPaper Class="pa-6" Elevation="2" Style="border-radius: 16px;">
            @if (_step == 0)
            {
                <MudText Typo="Typo.h6" Class="mb-4">Basic Information</MudText>
                <MudStack Spacing="4">
                    <MudTextField @bind-Value="_form.Title"
                                  Label="Course Title"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  HelperText="Make it descriptive and engaging"
                                  Counter="100"
                                  MaxLength="100"
                                  Immediate="true" />

                    <MudTextField @bind-Value="_form.Description"
                                  Label="Description"
                                  Variant="Variant.Outlined"
                                  Lines="4"
                                  Required="true"
                                  HelperText="Describe what students will learn"
                                  Counter="500"
                                  MaxLength="500"
                                  Immediate="true" />

                    <MudSelect T="CourseDifficulty" @bind-Value="_form.Difficulty"
                               Label="Difficulty Level"
                               Variant="Variant.Outlined">
                        <MudSelectItem Value="CourseDifficulty.Beginner">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.SentimentSatisfied" Color="Color.Success" Size="Size.Small" />
                                Beginner
                            </div>
                        </MudSelectItem>
                        <MudSelectItem Value="CourseDifficulty.Intermediate">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.SentimentNeutral" Color="Color.Warning" Size="Size.Small" />
                                Intermediate
                            </div>
                        </MudSelectItem>
                        <MudSelectItem Value="CourseDifficulty.Advanced">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.LocalFireDepartment" Color="Color.Error" Size="Size.Small" />
                                Advanced
                            </div>
                        </MudSelectItem>
                    </MudSelect>

                    <MudTextField @bind-Value="_form.ThumbnailUrl"
                                  Label="Thumbnail URL (optional)"
                                  Variant="Variant.Outlined"
                                  Placeholder="https://..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Image" />
                </MudStack>
            }
            else if (_step == 1)
            {
                <MudText Typo="Typo.h6" Class="mb-2">Programming Languages</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    Select the technologies covered in this course
                </MudText>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var tech in Enum.GetValues<CodingTechnology>())
                    {
                        var selected = _form.CodingTechnologies.Contains(tech);
                        <MudChip T="string"
                                 Color="@(selected ? Color.Primary : Color.Default)"
                                 Variant="@(selected ? Variant.Filled : Variant.Outlined)"
                                 OnClick="@(() => ToggleTech(tech))"
                                 Style="font-family: 'JetBrains Mono', monospace;">
                            @GetTechName(tech)
                        </MudChip>
                    }
                </div>
                @if (_form.CodingTechnologies.Count > 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-4">
                        @_form.CodingTechnologies.Count selected: @string.Join(", ", _form.CodingTechnologies.Select(GetTechName))
                    </MudText>
                }
            }
            else if (_step == 2)
            {
                <MudText Typo="Typo.h6" Class="mb-2">Tags</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    Help students find your course with relevant tags
                </MudText>
                <div class="d-flex gap-2 mb-4">
                    <MudTextField @bind-Value="_tagInput"
                                  Label="Add tag"
                                  Variant="Variant.Outlined"
                                  Placeholder="e.g. algorithms, data-structures"
                                  OnKeyDown="OnTagKeyDown"
                                  Immediate="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Tag" />
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="AddTag"
                               Disabled="@string.IsNullOrWhiteSpace(_tagInput)"
                               Style="min-width: 80px;">
                        Add
                    </MudButton>
                </div>
                @if (_form.Tags.Count > 0)
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var tag in _form.Tags)
                        {
                            <MudChip T="string"
                                     Color="Color.Secondary"
                                     Variant="Variant.Filled"
                                     OnClose="@(() => RemoveTag(tag))">
                                #@tag
                            </MudChip>
                        }
                    </div>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">No tags added yet.</MudText>
                }
            }
            else if (_step == 3)
            {
                <MudText Typo="Typo.h6" Class="mb-4">Review & Create</MudText>
                <MudPaper Class="pa-4 mb-4" Elevation="0"
                          Style="border: 1px solid rgba(128, 128, 128, 0.3); border-radius: 12px;">
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;" Class="mb-1">
                        @(string.IsNullOrEmpty(_form.Title) ? "(no title)" : _form.Title)
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        @(string.IsNullOrEmpty(_form.Description) ? "(no description)" : _form.Description)
                    </MudText>
                    <div class="d-flex gap-2 flex-wrap mb-2">
                        <DifficultyBadge Difficulty="_form.Difficulty" />
                        @foreach (var tech in _form.CodingTechnologies.Take(6))
                        {
                            <TechBadge Technology="tech" />
                        }
                        @if (_form.CodingTechnologies.Count > 6)
                        {
                            <MudChip T="string" Size="Size.Small">+@(_form.CodingTechnologies.Count - 6) more</MudChip>
                        }
                    </div>
                    @if (_form.Tags.Count > 0)
                    {
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var tag in _form.Tags)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary">#@tag</MudChip>
                            }
                        </div>
                    }
                </MudPaper>

                <MudSwitch @bind-Value="_form.IsPublished"
                           Color="Color.Primary"
                           Label="@(_form.IsPublished ? "Publish immediately" : "Save as draft")"
                           Class="mb-2" />
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-6 d-block">
                    @(_form.IsPublished
                        ? "Your course will be visible to all users right away."
                        : "You can publish it later after adding modules and lessons.")
                </MudText>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           OnClick="Submit"
                           Disabled="_saving"
                           StartIcon="@Icons.Material.Filled.RocketLaunch"
                           FullWidth="true">
                    @(_saving ? "Creating..." : "Create Course")
                </MudButton>
            }

            <!-- Navigation buttons -->
            <div class="d-flex justify-space-between mt-6">
                <MudButton Variant="Variant.Outlined"
                           OnClick="PrevStep"
                           Disabled="@(_step == 0)"
                           StartIcon="@Icons.Material.Filled.ArrowBack">
                    Previous
                </MudButton>
                @if (_step < _steps.Length - 1)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="NextStep"
                               Disabled="@(!CanProceed())"
                               EndIcon="@Icons.Material.Filled.ArrowForward">
                        Next
                    </MudButton>
                }
            </div>
        </MudPaper>
    </MudItem>

    <!-- Live Preview -->
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Elevation="2" Style="border-radius: 12px; position: sticky; top: 80px;">
            <MudText Typo="Typo.subtitle2" Class="mb-3">Live Preview</MudText>
            @if (!string.IsNullOrEmpty(_form.ThumbnailUrl))
            {
                <MudImage Src="@_form.ThumbnailUrl" Alt="Thumbnail" ObjectFit="ObjectFit.Cover"
                          Height="140" Class="rounded mb-3" Style="width: 100%; border-radius: 8px;" />
            }
            else
            {
                <MudPaper Class="d-flex align-center justify-center mb-3"
                          Elevation="0"
                          Style="height: 140px; border-radius: 8px; background: rgba(108,99,255,0.08); border: 1px dashed rgba(128, 128, 128, 0.3);">
                    <MudIcon Icon="@Icons.Material.Filled.Image" Color="Color.Secondary" Style="font-size: 3rem; opacity: 0.3;" />
                </MudPaper>
            }
            <DifficultyBadge Difficulty="_form.Difficulty" />
            <MudText Typo="Typo.h6" Class="mt-2" Style="font-weight: 600;">
                @(string.IsNullOrEmpty(_form.Title) ? "Your Course Title" : _form.Title)
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                @(string.IsNullOrEmpty(_form.Description)
                    ? "Your course description will appear here..."
                    : (_form.Description.Length > 120 ? _form.Description[..120] + "…" : _form.Description))
            </MudText>
            @if (_form.CodingTechnologies.Count > 0)
            {
                <div class="d-flex gap-1 mt-3 flex-wrap">
                    @foreach (var tech in _form.CodingTechnologies.Take(4))
                    {
                        <TechBadge Technology="tech" />
                    }
                </div>
            }
            @if (_form.Tags.Count > 0)
            {
                <div class="d-flex gap-1 mt-2 flex-wrap">
                    @foreach (var tag in _form.Tags)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary">#@tag</MudChip>
                    }
                </div>
            }
        </MudPaper>
    </MudItem>
</MudGrid>
