@page "/courses/{courseId}"

@inject ICoursesApiClient CoursesApi
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>@(_course?.Title ?? "Course") – CodeClash</PageTitle>

@if (_loading)
{
    <MudStack Spacing="4">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" Style="border-radius: 12px;" />
        <MudSkeleton Width="60%" Height="40px" />
        <MudSkeleton Width="40%" />
        <MudSkeleton Width="100%" Height="120px" />
    </MudStack>
}
else if (_course is null)
{
    <MudAlert Severity="Severity.Error">Course not found.</MudAlert>
}
else
{
    <!-- Breadcrumbs -->
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-4 px-0" />

    <!-- Course Header -->
    <MudPaper Class="pa-6 mb-6" Elevation="2" Style="border-radius: 16px; background: linear-gradient(135deg, #1A1A2E 0%, #16213E 100%);">
        <MudGrid Class="align-center">
            <MudItem xs="12" md="8">
                <div class="d-flex gap-2 mb-3 flex-wrap">
                    <DifficultyBadge Difficulty="_course.Difficulty" />
                    @if (!_course.IsPublished)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">Draft</MudChip>
                    }
                    @foreach (var tech in _course.CodingTechnologies.Take(4))
                    {
                        <TechBadge Technology="tech" />
                    }
                </div>
                <MudText Typo="Typo.h4" Style="color: white; font-weight: 700;">@_course.Title</MudText>
                <MudText Typo="Typo.body1" Style="color: #A0A8D0;" Class="mt-2 mb-4">@_course.Description</MudText>

                <div class="d-flex gap-4 flex-wrap">
                    <div class="d-flex align-center gap-1">
                        <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Size="Size.Small" />
                        <MudText Typo="Typo.body2" Style="color: white;">@_course.Rating.ToString("F1") (@_course.RatingCount reviews)</MudText>
                    </div>
                    <div class="d-flex align-center gap-1">
                        <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Secondary" Size="Size.Small" />
                        <MudText Typo="Typo.body2" Style="color: white;">@_course.EnrolledCount enrolled</MudText>
                    </div>
                    <div class="d-flex align-center gap-1">
                        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Primary" Size="Size.Small" />
                        <MudText Typo="Typo.body2" Style="color: white;">@_course.TotalXp XP total</MudText>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-1 mt-3">
                    @foreach (var tag in _course.Tags)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="color: #A0A8D0; border-color: #A0A8D0;">
                            #@tag
                        </MudChip>
                    }
                </div>
            </MudItem>
            @if (_isOwner)
            {
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4" Elevation="4" Style="border-radius: 12px; background: rgba(255,255,255,0.05);">
                        <MudText Typo="Typo.subtitle2" Style="color: white;" Class="mb-3">Course Actions</MudText>
                        <MudButton Href="@($"/courses/{_course.Id}/edit")"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Edit"
                                   FullWidth="true"
                                   Class="mb-2">
                            Edit Course
                        </MudButton>
                        <MudButton OnClick="DeleteCourse"
                                   Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Delete"
                                   FullWidth="true">
                            Delete Course
                        </MudButton>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    </MudPaper>

    <!-- Modules Section -->
    <div class="d-flex align-center justify-space-between mb-4">
        <MudText Typo="Typo.h5" Style="font-weight: 600;">
            Course Content
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ml-2">
                @_course.Modules.Count modules
            </MudChip>
        </MudText>
        @if (_isOwner)
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="ShowAddModuleDialog">
                Add Module
            </MudButton>
        }
    </div>

    @if (_course.Modules.Count == 0)
    {
        <MudPaper Class="pa-6 text-center" Elevation="1" Style="border-radius: 12px;">
            <MudIcon Icon="@Icons.Material.Filled.ViewModule" Size="Size.Large" Color="Color.Secondary" Style="font-size: 3rem;" />
            <MudText Typo="Typo.h6" Class="mt-2">No modules yet</MudText>
            @if (_isOwner)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Start building your course by adding modules</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ShowAddModuleDialog">Add First Module</MudButton>
            }
        </MudPaper>
    }
    else
    {
        <MudExpansionPanels MultiExpansion="true">
            @foreach (var module in _course.Modules.OrderBy(m => m.Order))
            {
                <MudExpansionPanel>
                    <TitleContent>
                        <div class="d-flex align-center gap-3 w-100">
                            <MudIcon Icon="@Icons.Material.Filled.ViewModule" Color="Color.Primary" />
                            <div class="flex-grow-1">
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">@module.Title</MudText>
                                @if (!string.IsNullOrEmpty(module.Description))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@module.Description</MudText>
                                }
                            </div>
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">
                                @module.Lessons.Count lessons
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                @module.XpReward XP
                            </MudChip>
                            @if (_isOwner)
                            {
                                <span @onclick:stopPropagation="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   OnClick="@(() => ShowEditModuleDialog(module))" />
                                </span>
                                <span @onclick:stopPropagation="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => DeleteModule(module))" />
                                </span>
                            }
                        </div>
                    </TitleContent>
                    <ChildContent>
                        <MudList T="LessonResponse" Dense="true">
                            @foreach (var lesson in module.Lessons.OrderBy(l => l.Order))
                            {
                                <MudListItem T="LessonResponse">
                                    <div class="d-flex align-center gap-3 w-100 py-1">
                                        <LessonTypeIcon Type="lesson.Type" />
                                        <MudText Typo="Typo.body2" Class="flex-grow-1">@lesson.Title</MudText>
                                        @if (_isOwner)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Size="Size.Small"
                                                           Color="Color.Primary"
                                                           OnClick="@(() => Navigation.NavigateTo($"/courses/{_course.Id}/modules/{module.ModuleId}/lessons/{lesson.LessonId}/edit"))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Size="Size.Small"
                                                           Color="Color.Error"
                                                           OnClick="@(() => DeleteLesson(module.ModuleId, lesson))" />
                                        }
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                        @if (_isOwner)
                        {
                            <div class="pa-2">
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           Size="Size.Small"
                                           OnClick="@(() => ShowAddLessonDialog(module.ModuleId))">
                                    Add Lesson
                                </MudButton>
                            </div>
                        }
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    }

    <!-- Add / Edit Module Dialog -->
    <MudDialog @bind-Visible="_showAddModule">
        <TitleContent>
            <MudText Typo="Typo.h6">@(_moduleForm.EditingModuleId is null ? "Add Module" : "Edit Module")</MudText>
        </TitleContent>
        <DialogContent>
            <MudTextField @bind-Value="_moduleForm.Title" Label="Title" Variant="Variant.Outlined" Required="true" Class="mb-3" />
            <MudTextField @bind-Value="_moduleForm.Description" Label="Description" Variant="Variant.Outlined" Lines="2" Class="mb-3" />
            <MudNumericField @bind-Value="_moduleForm.Order" Label="Order" Variant="Variant.Outlined" Min="0" Class="mb-3" />
            <MudNumericField @bind-Value="_moduleForm.XpReward" Label="XP Reward" Variant="Variant.Outlined" Min="0" />
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _showAddModule = false)">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveModule" Disabled="_saving">
                @(_saving ? "Saving..." : (_moduleForm.EditingModuleId is null ? "Add Module" : "Save Changes"))
            </MudButton>
        </DialogActions>
    </MudDialog>

    <!-- Add Lesson Dialog -->
    <MudDialog @bind-Visible="_showAddLesson">
        <TitleContent>
            <MudText Typo="Typo.h6">Add Lesson</MudText>
        </TitleContent>
        <DialogContent>
            <MudTextField @bind-Value="_lessonForm.Title" Label="Title" Variant="Variant.Outlined" Required="true" Class="mb-3" />
            <MudGrid Class="mb-3">
                <MudItem xs="8">
                    <MudSelect T="LessonType" @bind-Value="_lessonForm.Type" Label="Type" Variant="Variant.Outlined">
                        <MudSelectItem Value="LessonType.Theory">Theory</MudSelectItem>
                        <MudSelectItem Value="LessonType.CodingChallenge">Coding Challenge</MudSelectItem>
                        <MudSelectItem Value="LessonType.Quiz">Quiz</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="4">
                    <MudNumericField @bind-Value="_lessonForm.Order" Label="Order" Variant="Variant.Outlined" Min="0" />
                </MudItem>
            </MudGrid>
            @if (_lessonForm.Type == LessonType.Theory)
            {
                <MudTextField @bind-Value="_lessonForm.Content"
                              Label="Content (Markdown)"
                              Variant="Variant.Outlined"
                              Lines="6"
                              Placeholder="Write lesson content in Markdown... (you can also edit this later)"
                              Style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem;" />
            }
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _showAddLesson = false)">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveLesson" Disabled="_saving">
                @(_saving ? "Saving..." : "Add Lesson")
            </MudButton>
        </DialogActions>
    </MudDialog>
}
